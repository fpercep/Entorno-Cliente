+</head>
+<body>
+    <script>
+        function establecerCookie(nombre, valor, dias){
+            let valorEncriptado = encodeURIComponent(valor.toUpperCase());
+            document.cookie = normalizarTexto(nombre) + "=" + valorEncriptado + ";expired=" + calcularDias(dias);
+        }
+        function calcularDias(dias){
+            dias = Number(dias);
+            let fecha = new Date();
+            fecha.setDate(fecha.getDate() + dias);
+            return fecha.toUTCString();
+        }
+        function obtenerCookie(nombre){
+            let cookies = document.cookie.split(';');
+            console.log(cookies);
+            cookies.find(cookie => cookie.startsWith(nombre));
+            return  cookies.find(cookie => cookie.startsWith(normalizarTexto(nombre)+"="));
+        }
+        function comprobarCookie(valor){
+            let cookie = obtenerCookie("usuario");
+            if (cookie.split('=')[1]===valor.toUpperCase()) {
+                alert("Bienvenido de nuevo " + valor);
+            }else {
+                let nombre = prompt("Introduzaca un nombre:").toUpperCase();
+                establecerCookie("usuario",nombre,30);
+            }
