+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="UTF-8">
+    <title>Title</title>
+</head>
+<body>
+<script>
+    let personajes = [
+        {nombre: "John", Anime: "Juan Ataca", Poder: "Juanear", Rol: "Heroe", descripcion: ""},
+        {nombre: "Juan", Anime: "Juan Ataca", Poder: "Juanear", Rol: "Heroe", descripcion: ""},
+        {nombre: "Pepe", Anime: "Juan Ataca", Poder: "Juanear", Rol: "Villano", descripcion: ""},
+    ]
+
+    function registrarPersonaje() {
+        let n = prompt("Introduce el Nombre del personaje:");
+        let a = prompt("Introduce el Anime del personaje:");
+        let p = prompt("Introduce el Poder del personaje:");
+        let r = prompt("Introduce el Rol del personaje:");
+        let d = prompt("Introduce la Descripcion del personaje:");
+
+        personajes.push({nombre: n, Anime: a, Poder: p, Rol: r, descripcion: d},
+        )
+    }
+
+    function guardarPersonajes() {
+        // El enunciado pide local Storage, no web Storage
+        localStorage.setItem("personajes", JSON.stringify(personajes));
+    }
+
+    function cargarPersonajes() {
+         return JSON.parse(localStorage.getItem("personajes"));
+    }
+
+    function filtrarPorRol(rol){
+        return personajes.filter(personaje => personaje.Rol === rol)
+    }
+
+    function mostarRanking(){
+        return personajes.toSorted((a, b) => a.nombre - b.nombre);
+    }
+    function mostarDescripcion(){
+        return personajes.map(personaje => personaje.descripcion);
+    }
+
+    guardarPersonajes()
+    cargarPersonajes()
+    console.log(filtrarPorRol("Heroe"));
+    console.log(mostarRanking());
+    console.log(mostarDescripcion());
+</script>
+</body>
+</html>
