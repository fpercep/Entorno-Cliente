+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="UTF-8">
+    <title>Gestor Inventario RPG</title>
+</head>
+<body>
+    <script>
+        let inventario = [
+            {
+                nombre: "Excalibur",
+                tipo: "Arma",
+                rareza: "Legendaria",
+                fechaObtencion: new Date("2025-12-02")
+            },
+            {
+                nombre: "Poción de Vida",
+                tipo: "Consumible",
+                rareza: "Común",
+                fechaObtencion: new Date("2025-11-20")
+            },
+            {
+                nombre: "Escudo de Dragón",
+                tipo: "Armadura",
+                rareza: "Épica",
+                fechaObtencion: new Date("2025-10-15")
+            },
+            {
+                nombre: "Juan",
+                tipo: "Acompañante",
+                rareza: "Rara",
+                fechaObtencion: new Date("2025-12-02")
+            }
+        ];
+
+        localStorage.setItem("inventario", JSON.stringify(inventario));
+
+        function crearObjeto(nombre, tipo, rareza){
+            let patron = /^[a-zA-ZÁ-ÿ\s]+$/;
+            if (!patron.test(nombre)) {
+                console.log(`Error: El nombre "${nombre}" contiene caracteres no válido`);
+            } else {
+                let tipoFormateado = tipo.toLowerCase();
+                let rarezaFormateada = rareza.toLowerCase();
+
+                let nuevoItem = {
+                    nombre: nombre,
+                    tipo: tipoFormateado,
+                    rareza: rarezaFormateada,
+                    fechaObtencion: new Date()
+                };
+
+                inventario.push(nuevoItem);
+                console.log(`Ítem "${nombre}" añadido correctamente.`);
+            }
+            localStorage.setItem("inventario", JSON.stringify(inventario));
+        }
+
+        function objetosXTipo(){
+            let conteoXtipo = new Map;
+            for (const objeto of inventario) {
+                if (conteoXtipo.has(objeto.tipo)) {
+                    let cantidadActual = conteoXtipo.get(objeto.tipo);
+                    conteoXtipo.set(objeto.tipo, cantidadActual + 1);
+                } else {
+                    conteoXtipo.set(objeto.tipo, 1)
+                }
+            }
+            return conteoXtipo;
+        }
+
+        function diasEnInventario(fecha){
+            let hoy = new Date();
+            return  hoy.getDate() - fecha.getDate();
+        }
+
+        function crearCookie(nombre){
+            let nombreEncrip = encodeURIComponent(nombre.toUpperCase());
+            let fecha = new Date();
+            fecha.setDate(fecha.getDate() + 2);
+            document.cookie = "actividadFavorita=" + nombreEncrip +";expires=" + fecha.toUTCString();
+        }
+
+
+    </script>
+</body>
+</html>
