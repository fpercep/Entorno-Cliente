+            {nombre:"Gamer4", tipo: "Rol" , fecha: "2005-12-05"},
+        ]
+
+        function normalizarTexto(texto){
+            return texto.toLowerCase().trim();
+        }
+
+        function filtrarPorTipo(tipo){
+            let output = []
+            for (const evento of eventosGamer) {
+                if (normalizarTexto(evento.tipo) === normalizarTexto(tipo)){
+                    output.push(evento);
+                }
+            }
+            return output;
+        }
+
+        function buscarEvento(palabra){
+            return eventosGamer.filter(evento => normalizarTexto(evento.nombre).includes(normalizarTexto(palabra)));
+        }
+
+        let participantes = new Map();
+        eventosGamer.forEach(evento => participantes.set(evento.nombre, 0));
+        localStorage.setItem("eventosGamer",JSON.stringify(eventosGamer));
+
